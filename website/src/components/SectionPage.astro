---
import { getCollection } from 'astro:content';
import { t, path, routeNames, features, systems, entities, faq, state } from '../data/site';
import ProjectStatus from './ProjectStatus.astro';
import StatusBadge from './StatusBadge.astro';
import PhaseTimeline from './PhaseTimeline.astro';
import CausalChain from './CausalChain.astro';
import EraJourney from './EraJourney.astro';
const { route, lang = 'es' } = Astro.props;
const i = lang === 'es' ? 0 : 1;
const diaries = (await getCollection('diaries')).filter(d=>d.data.lang===lang);
const changes = (await getCollection('changes')).sort((a,b)=>b.data.date.localeCompare(a.data.date));
const descriptions = {
 juego: ['Guía a un pueblo. Cambia las causas. Comprende la historia que dejas atrás.','Guide a people. Change the causes. Understand the history you leave behind.'],
 'hoja-de-ruta': ['Un horizonte ambicioso. Pasos concretos para llegar hasta él.','An ambitious horizon. Concrete steps to reach it.'],
 diarios: ['Cómo se construye un mundo que puede explicar su propia historia.','How to build a world that can explain its own history.'],
 cambios: ['Qué cambió, cuándo y por qué. El proyecto también tiene memoria.','What changed, when and why. The project has a memory too.'],
 comunidad: ['Un lugar para seguir el desarrollo y hacer mejores preguntas.','A place to follow development and ask better questions.'],
 estudio: ['Un estudio pequeño. Una visión de largo recorrido. Responsabilidad humana.','A small studio. A long-term vision. Human responsibility.'],
 motor: ['La tecnología propuesta detrás de una historia que puedes interrogar.','The proposed technology behind a history you can question.'],
 prensa: ['Información clara para quienes cuentan historias sobre juegos.','Clear information for people telling stories about games.'],
 faq: ['Lo que sabemos. Lo que buscamos. Lo que aún está abierto.','What we know. What we aim for. What remains open.'],
 'juego/sistemas': ['Nueve sistemas conectados. Ninguna decisión vive aislada.','Nine connected systems. No decision exists in isolation.'],
 'juego/epocas': ['Las fechas orientan. Las condiciones transforman el mundo.','Dates guide us. Conditions transform the world.'],
 'juego/mundo': ['El Mediterráneo oriental: el horizonte propuesto para la primera vertical.','The Eastern Mediterranean: the proposed horizon for the first vertical slice.'],
 'juego/situaciones': ['Los acontecimientos necesitan causas, no una cita en el calendario.','Events need causes, not an appointment on a calendar.'],
 modding: ['La futura casa de quienes quieran construir otras historias.','The future home of people who want to build other histories.'],
 legal: ['Transparencia sobre este prototipo y sus próximos pasos.','Transparency about this prototype and its next steps.'],
 'legal/privacidad': ['Datos mínimos. Decisiones explícitas.','Minimal data. Explicit decisions.'],
 'legal/aviso': ['Datos de identificación pendientes de completar antes del lanzamiento público.','Identification details to be completed before public launch.'],
 'legal/terminos': ['El estado actual de los materiales y su uso.','The current status of the materials and their use.'],
 'legal/ia': ['Cómo se ha construido este sitio y qué recursos utiliza.','How this website was built and which resources it uses.']
};
const future = ['juego/sistemas','juego/epocas','motor','faq','prensa'].includes(route) ? 'W2' : ['juego/mundo','juego/situaciones'].includes(route) ? 'W3' : route==='modding' ? 'W4' : null;
---
<div class="page-top section"><a class="breadcrumb" href={path(lang)}>{t(lang,'Inicio','Home')}</a><span aria-hidden="true"> / </span><span class="breadcrumb">{routeNames[route][i]}</span><div class="page-title-row"><div><span class="eyebrow">101 AGENTS GAMES / {route.startsWith('juego') ? t(lang,'PROJECT EPOCH · NOMBRE PROVISIONAL','PROJECT EPOCH · WORKING TITLE') : t(lang,'CUADERNO DEL PROYECTO','PROJECT NOTEBOOK')}</span><h1>{routeNames[route][i]}</h1><p class="page-description">{descriptions[route]?.[i]}</p></div><span class="page-ornament" aria-hidden="true">✳</span></div>{future && <div class="notice"><StatusBadge label={t(lang,`Vista previa · ${future}`,`Preview · ${future}`)}/><p>{t(lang,'Sección prevista para una etapa futura. El contenido es un borrador del diseño, pendiente de revisión humana.','This section is planned for a future stage. Content is a design draft awaiting human review.')}</p></div>}</div>

{route === 'juego' && <>
 <section class="section game-overview"><div><p class="large-copy">{t(lang,'Dirige a un pueblo desde 1300 hasta más allá de 2060 en una sola partida. Cada guerra cuesta grano, hombres y deuda; cada reforma cambia quién manda; cada invento necesita sus precursores.','Lead a people from 1300 to beyond 2060 in one campaign. Every war costs grain, people and debt; every reform changes who holds power; every invention needs its precursors.')}</p><blockquote>{t(lang,'«Guío a mi pueblo a lo largo de siete siglos y entiendo exactamente por qué el mundo terminó siendo como es».','“I guide my people across seven centuries and understand exactly why the world became what it is.”')}</blockquote><p class="caption">{t(lang,'Fantasía del jugador · objetivo de diseño','Player fantasy · design target')}</p></div><figure><img src="/images/atlas.svg" alt={t(lang,'Mapa conceptual de la región propuesta para la vertical','Concept map of the proposed vertical slice region')} width="1100" height="800"/><figcaption>{t(lang,'Ilustración conceptual. No representa una build jugable.','Concept illustration. Does not depict a playable build.')}</figcaption></figure></section>
 <section class="section"><span class="eyebrow">{t(lang,'CINCO DIFERENCIADORES BUSCADOS','FIVE INTENDED DIFFERENTIATORS')}</span><div class="feature-list">{features.map(f=><article><span class="feature-number">{f[0]}</span><h2>{f[1+i]}</h2><p>{f[3+i]}</p></article>)}</div></section>
 <section class="causal-section"><div class="section"><span class="eyebrow">{t(lang,'UN AÑO DE PARTIDA · EJEMPLO DE DISEÑO','A YEAR OF PLAY · DESIGN EXAMPLE')}</span><h2>{t(lang,'Primavera de 1303. Y lo que vino después.','Spring 1303. And what followed.')}</h2><CausalChain lang={lang}/></div></section>
 <section class="section"><div class="section-heading"><h2>{t(lang,'De un instante a una era.','From a moment to an era.')}</h2><p>{t(lang,'Cuatro escalas de decisión, conectadas por sus consecuencias.','Four scales of decision, connected by their consequences.')}</p></div><div class="loops">{(lang==='es'?[['Inmediata','Segundos y minutos','Alerta → causa → decisión → reanudar'],['Operativa','Meses y años','Guerra, crisis fiscal, reforma o tratado'],['Estratégica','Décadas','Instituciones, alianzas y objetivos'],['Histórica','Siglos','Transformación, continuidad y crónica']]:[['Immediate','Seconds and minutes','Alert → cause → decision → resume'],['Operational','Months and years','War, fiscal crisis, reform or treaty'],['Strategic','Decades','Institutions, alliances and goals'],['Historical','Centuries','Transformation, continuity and chronicle']]).map(([title,period,copy])=><article><span class="eyebrow">{period}</span><h3>{title}</h3><p>{copy}</p></article>)}</div><div class="editorial-note"><h3>{t(lang,'La historia tiene inercia, no un guion.','History has inertia, not a script.')}</h3><p>{t(lang,'No es un sandbox sin reglas. La geografía, la tecnología, la política y los recursos limitan lo posible. Tus decisiones cambian las causas dentro de esas restricciones.','This is not a sandbox without rules. Geography, technology, politics and resources constrain what is possible. Your decisions change the causes within those constraints.')}</p></div><div class="link-grid">{['juego/sistemas','juego/epocas','juego/mundo','juego/situaciones'].map(r=><a href={path(lang,r)}>{routeNames[r][i]} <span aria-hidden="true">↗</span></a>)}</div></section><div class="section"><ProjectStatus lang={lang}/></div>
 </>}

{route === 'hoja-de-ruta' && <section class="section roadmap-body"><div class="notice roadmap-notice"><span aria-hidden="true">↗</span><p>{t(lang,'Las fechas son orientativas y pueden cambiar. Cuando cambien, lo explicaremos en un diario.','Dates are estimates and may change. When they do, we will explain why in a dev diary.')}</p></div><p>{t(lang,'Estado basado en los documentos del 24 de octubre de 2026. No se da por terminada ninguna fase sin evidencia de su puerta de salida.','Status based on the documents of 24 October 2026. No phase is marked complete without evidence that its exit criteria have been met.')}</p><PhaseTimeline lang={lang}/><div class="editorial-note"><span class="eyebrow">{t(lang,'DESPUÉS DEL LANZAMIENTO · PROPUESTAS SIN FECHA','AFTER LAUNCH · UNDATED PROPOSALS')}</span><h2>{t(lang,'Más historias por abrir.','More histories to unfold.')}</h2><div class="post-launch-grid">{(lang==='es'?[['Actualizaciones gratuitas','Balance, rendimiento, calidad de vida y situaciones.'],['Expansiones regionales','Rutas de la seda, océano Índico, mundo atlántico y África.'],['Expansiones temporales','Revoluciones, industrialización, guerras mundiales, era nuclear y digital, siglo XXI.'],['Herramientas y multijugador','Forge público y multijugador: propuestas, sin fecha confirmada.']]:[['Free updates','Balance, performance, quality of life and situations.'],['Regional expansions','Silk Roads, Indian Ocean, Atlantic world and Africa.'],['Temporal expansions','Revolutions, industry, world wars, nuclear and digital eras, the 21st century.'],['Tools and multiplayer','Public Forge and multiplayer: proposals with no confirmed date.']]).map(([title,copy])=><div><h3>{title}</h3><p>{copy}</p></div>)}</div><a class="text-link" href={path(lang,'cambios')}>{t(lang,'Consultar cambios de plan','See changes to the plan')} ↗</a></div></section>}

{route === 'diarios' && <section class="section"><div class="notice"><p>{t(lang,'Los diarios periódicos están previstos desde la Fase 2. Este prototipo incluye un borrador editorial; no hay publicaciones aprobadas todavía.','Regular diaries are planned from Phase 2. This prototype includes an editorial draft; no publications have been approved yet.')}</p></div><div class="filter-bar" data-filter-container="diaries"><label>{t(lang,'Buscar en los diarios','Search diaries')}<input id="diary-search" type="search" placeholder={t(lang,'Título, tema o sistema…','Title, topic or system…')} /></label><label>{t(lang,'Tipo','Type')}<select id="diary-type"><option value="all">{t(lang,'Todos los tipos','All types')}</option><option value="design">{t(lang,'Diseño','Design')}</option><option value="technical">{t(lang,'Técnico','Technical')}</option><option value="history">{t(lang,'Historia','History')}</option><option value="art">{t(lang,'Arte','Art')}</option><option value="studio">{t(lang,'Estudio','Studio')}</option></select></label><a class="rss-link" href={path(lang)+'diarios/rss.xml'}>RSS ↗</a></div><p class="filter-count" aria-live="polite" data-result-count></p><div class="diary-list">{diaries.map(d=><article data-diary data-type={d.data.type} data-search={[d.data.title,...d.data.systems].join(' ').toLocaleLowerCase(lang)}><div class="diary-date"><span>24</span><small>OCT 2026</small></div><div><StatusBadge label={d.data.status==='draft'?t(lang,'Borrador editorial','Editorial draft'):t(lang,'Publicado','Published')}/><h2><a href={path(lang,'diarios/'+d.data.translationKey)}>{d.data.title}</a></h2><p>{d.data.description}</p><span class="caption">{t(lang,'Fase','Phase')} {d.data.phase} · {d.data.minutes} min · {d.data.systems.join(' / ')}</span></div><a class="round-link" href={path(lang,'diarios/'+d.data.translationKey)} aria-label={t(lang,'Leer: ','Read: ')+d.data.title}>↗</a></article>)}</div><p class="empty-result" hidden data-empty>{t(lang,'No hay diarios que coincidan. Prueba otro tema o selecciona todos los tipos.','No diaries match. Try another topic or select all types.')}</p><div class="editorial-note"><span class="eyebrow">{t(lang,'EN LA MESA DE TRABAJO · TEMAS PROPUESTOS','ON THE WORKTABLE · PROPOSED TOPICS')}</span><ul class="topic-list">{(lang==='es'?['La historia tiene inercia: así se propone 101 History.','Determinismo: la misma semilla, la misma historia.','El registro causal: preguntarle «¿por qué?» a un precio.','Un estudio con agentes de IA: reglas y revisión humana.','Dibujar el mapa: de la textura de IDs al pergamino.']:['History has inertia: the proposal for 101 History.','Determinism: the same seed, the same history.','The causal ledger: asking a price “why?”.','A studio with AI agents: rules and human review.','Drawing the map: from ID texture to parchment.']).map(title=><li>{title}<span>{t(lang,'Planificado','Planned')}</span></li>)}</ul></div></section>}

{route === 'cambios' && <section class="section"><div class="notice"><p>{t(lang,'Registro de revisión del prototipo. Las entradas son borradores; no se anuncian builds del juego. Los RSS incluirán solo entradas aprobadas.','Prototype review log. Entries are drafts; no game builds are announced. RSS feeds will contain approved entries only.')}</p></div><div class="filter-bar"><label>{t(lang,'Canal','Channel')}<select id="change-channel"><option value="all">{t(lang,'Todos los canales','All channels')}</option><option value="juego">{t(lang,'Juego','Game')}</option><option value="diseno">{t(lang,'Diseño','Design')}</option><option value="sitio">{t(lang,'Sitio','Website')}</option></select></label><label>{t(lang,'Tipo de cambio','Change type')}<select id="change-kind"><option value="all">{t(lang,'Todos los tipos','All types')}</option>{[['added','Añadido','Added'],['changed','Cambiado','Changed'],['fixed','Corregido','Fixed'],['removed','Eliminado','Removed'],['performance','Rendimiento','Performance']].map(([value,es,en])=><option value={value}>{t(lang,es,en)}</option>)}</select></label><a class="rss-link" href={path(lang)+'cambios/rss.xml'}>RSS ↗</a></div><p class="filter-count" aria-live="polite" data-result-count></p><div class="change-list">{changes.map(c=><article class="change-entry" data-change data-channel={c.data.channel} data-kinds={['added','changed','fixed','removed','performance'].filter(k=>c.data[k][lang].length).join(' ')}><div class="change-version"><span class="eyebrow">{{juego:t(lang,'JUEGO','GAME'),diseno:t(lang,'DISEÑO','DESIGN'),sitio:t(lang,'SITIO','WEBSITE')}[c.data.channel]}</span><h2>v{c.data.version}</h2><time datetime={c.data.date}>{c.data.date}</time></div><div><StatusBadge label={t(lang,'Borrador para revisión','Draft for review')}/><h3>{c.data.summary[lang]}</h3>{[['added','Añadido','Added'],['changed','Cambiado','Changed'],['fixed','Corregido','Fixed'],['removed','Eliminado','Removed'],['performance','Rendimiento','Performance']].map(([kind,es,en])=>c.data[kind][lang].length>0&&<section data-change-group={kind}><h4>{t(lang,es,en)}</h4><ul>{c.data[kind][lang].map(item=><li>{item}</li>)}</ul></section>)}</div></article>)}</div><p class="empty-result" hidden data-empty>{t(lang,'No hay entradas para esta combinación. No se ha publicado ninguna versión del juego.','No entries match these filters. No game version has been published.')}</p></section>}

{route === 'comunidad' && <section class="section community-grid"><div id="boletin" class="newsletter-panel"><span class="eyebrow">{t(lang,'EL BOLETÍN DEL ESTUDIO','THE STUDIO NEWSLETTER')}</span><h2>{t(lang,'Solo cuando haya','Only when there is')}<br/><em>{t(lang,'algo que contar.','something to share.')}</em></h2><p>{t(lang,'Diarios, hitos y pruebas cuando estén listos. El boletín se abrirá al elegir un proveedor con doble confirmación y publicar la información de privacidad.','Diaries, milestones and tests when they are ready. The newsletter will open once a double opt-in provider is selected and privacy information is published.')}</p>{state.newsletterUrl?<a class="button" href={state.newsletterUrl}>{t(lang,'Abrir suscripción','Open subscription')} ↗</a>:<div class="newsletter-pending"><StatusBadge label={t(lang,'Inscripciones aún cerradas','Sign-ups not open yet')}/><p>{t(lang,'Por ahora no solicitamos ni guardamos tu correo. Puedes añadir el canal RSS a tu lector; aparecerán novedades cuando se aprueben para publicar.','For now, we do not request or store your email. Add the RSS feed to your reader; updates will appear when approved for publication.')}</p><a class="button" href={path(lang)+'diarios/rss.xml'}>{t(lang,'Seguir por RSS','Follow via RSS')} ↗</a></div>}<a class="subtle-link" href={path(lang,'legal/privacidad')}>{t(lang,'Sobre la privacidad','About privacy')}</a></div><div class="community-side"><h2>{t(lang,'Una comunidad con criterio.','A thoughtful community.')}</h2><p>{t(lang,'Queremos conversaciones sobre sistemas, historia y decisiones. Un desacuerdo explicado vale más que un aplauso automático.','We want conversations about systems, history and decisions. An explained disagreement is worth more than automatic applause.')}</p><div class="community-channel"><h3>Discord</h3><StatusBadge label={t(lang,'Por anunciar','To be announced')}/><p>{t(lang,'El servidor y sus moderadores se anunciarán antes de abrir las invitaciones.','The server and its moderators will be announced before invitations open.')}</p></div><div class="community-channel"><h3>{t(lang,'Comentarios y pruebas','Feedback and testing')}</h3><p>{t(lang,'Las sesiones externas están previstas desde la Fase 2. Publicaremos cómo participar y cómo enviar un reporte reproducible.','External sessions are planned from Phase 2. We will publish how to participate and how to submit a reproducible report.')}</p></div><h3>{t(lang,'Normas propuestas','Proposed guidelines')}</h3><ul><li>{t(lang,'Critica las ideas; respeta a las personas.','Critique ideas; respect people.')}</li><li>{t(lang,'Cita fuentes y distingue hechos de hipótesis.','Cite sources and distinguish facts from hypotheses.')}</li><li>{t(lang,'Sin acoso, discriminación ni datos personales ajenos.','No harassment, discrimination or others’ personal data.')}</li><li>{t(lang,'El contenido sensible requiere contexto y cuidado.','Sensitive content requires context and care.')}</li></ul></div></section>}

{route === 'estudio' && <section class="section"><div class="editorial-split"><div><span class="eyebrow">{t(lang,'SOBRE 101 AGENTS GAMES','ABOUT 101 AGENTS GAMES')}</span><h2>{t(lang,'Construir mundos.','Building worlds.')}<br/><em>{t(lang,'Entender sus causas.','Understanding their causes.')}</em></h2></div><div class="prose"><p>{t(lang,'101 Agents Games desarrolla una visión de gran estrategia histórica donde los cambios del mundo se pueden explicar. El documento de producción contempla una persona con 20–30 horas semanales y apoyo intensivo de agentes de IA.','101 Agents Games is developing a vision of historical grand strategy where changes in the world can be explained. The production plan assumes one person working 20–30 hours per week with extensive AI-agent assistance.')}</p><p>{t(lang,'Ese alcance exige pasos pequeños y comprobables: validar la economía, construir el núcleo y demostrar una vertical antes de ampliar el mundo.','That scope demands small, testable steps: validate the economy, build the core and prove a vertical slice before expanding the world.')}</p></div></div><div class="responsibility-grid"><article><span class="eyebrow">{t(lang,'LO QUE HACEN LOS AGENTES','WHAT AGENTS DO')}</span><h3>{t(lang,'Proponer, construir, comprobar.','Propose, build, test.')}</h3><p>{t(lang,'Código, pruebas, documentación, herramientas, preparación de datos y borradores de texto. Su trabajo debe poder revisarse y reproducirse.','Code, tests, documentation, tools, data preparation and text drafts. Their work must be reviewable and reproducible.')}</p></article><article><span class="eyebrow">{t(lang,'LO QUE DECIDE UNA PERSONA','WHAT A HUMAN DECIDES')}</span><h3>{t(lang,'Dirección, integración y aprobación.','Direction, integration and approval.')}</h3><p>{t(lang,'Diseño, arquitectura, calidad, alcance, contenido histórico y sensible, fechas, precios y publicación. Los agentes no aprueban su propio trabajo.','Design, architecture, quality, scope, historical and sensitive content, dates, prices and publication. Agents do not approve their own work.')}</p></article></div><div class="editorial-note"><h2>{t(lang,'La historia merece revisión.','History deserves review.')}</h2><p>{t(lang,'Los datos históricos del documento maestro son material de trabajo. Antes de convertirse en contenido público, se contrastan con fuentes en la Biblia histórica. Las incertidumbres se declaran y las personas no se reducen a estereotipos.','Historical data in the master document is working material. Before becoming public content, it is checked against sources in the historical bible. Uncertainty is disclosed and people are not reduced to stereotypes.')}</p><p>{t(lang,'Los agentes de desarrollo son distintos de la IA que toma decisiones dentro del juego. No son el mismo sistema ni tienen el mismo propósito.','Development agents are separate from the AI making decisions inside the game. They are different systems with different purposes.')}</p><a class="text-link" href={path(lang,'legal/ia')}>{t(lang,'Consultar uso de IA y créditos','Read about AI use and credits')} ↗</a></div></section>}

{route === 'motor' && <section class="section"><div class="engine-equation"><span>{t(lang,'MISMA SEMILLA','SAME SEED')}</span><b>+</b><span>{t(lang,'MISMOS DATOS Y COMANDOS','SAME DATA AND COMMANDS')}</span><b>=</b><span>{t(lang,'MISMA HISTORIA','SAME HISTORY')}</span><small>{t(lang,'Objetivo de determinismo · con el mismo binario','Determinism target · with the same binary')}</small></div><div class="system-grid">{(lang==='es'?[['101 Sim','La simulación avanza sin depender de gráficos. El cliente observa y envía órdenes; el mundo conserva sus reglas.'],['Registro causal','Cada cambio visible debería registrar su origen: una herramienta para el jugador y para detectar errores.'],['101 History','Las situaciones aparecen por condiciones del mundo. La historia real es una trayectoria plausible.'],['101 Lab','Campañas sin gráficos para medir precios, estabilidad, decisiones de IA y divergencia. Sin cifras de rendimiento inventadas.'],['101 Forge','Editor de contenido propuesto para validar mapas, escenarios y datos con las mismas reglas que el motor.'],['Datos y verificación','Separar motor y contenido permite comparar versiones y reproducir problemas con semillas y comandos.']]:[['101 Sim','Simulation advances independently of graphics. The client observes and sends commands; the world keeps its rules.'],['Causal ledger','Each visible change should record its origin: a tool for players and for finding errors.'],['101 History','Situations emerge from world conditions. Real history is one plausible trajectory.'],['101 Lab','Headless campaigns to measure prices, stability, AI decisions and divergence. No invented performance figures.'],['101 Forge','A proposed content editor validating maps, scenarios and data with the same rules as the engine.'],['Data and verification','Separating engine and content allows version comparisons and reproducing issues using seeds and commands.']]).map(([title,copy])=><article><h2>{title}</h2><p>{copy}</p><StatusBadge label={t(lang,'Propuesto','Proposed')}/></article>)}</div><a class="text-link" href={path(lang,'diarios')}>{t(lang,'Seguir los futuros diarios técnicos','Follow future technical diaries')} ↗</a></section>}

{route === 'juego/sistemas' && <section class="section"><div class="system-grid">{systems.map((s,n)=><article><span class="eyebrow">{String(n+1).padStart(2,'0')} / {t(lang,'PROPUESTO','PROPOSED')}</span><h2>{s[i]}</h2><p>{s[2+i]}</p><div class="system-example"><strong>{t(lang,'Un ejemplo','An example')}</strong><p>{s[4+i]}</p></div></article>)}</div><p class="caption">{t(lang,'Ejemplos de diseño resumidos del documento maestro v0.7, §§09–17. No son resultados de simulaciones ejecutadas.','Design examples summarized from master document v0.7, §§09–17. They are not results of executed simulations.')}</p></section>}

{route === 'juego/epocas' && <section class="section"><EraJourney lang={lang} full/><div class="editorial-note"><h3>{t(lang,'El calendario no desbloquea una época.','The calendar does not unlock an era.')}</h3><p>{t(lang,'Las instituciones, las tecnologías y las condiciones sociales cambian la partida. Los límites de estas seis épocas siguen la Parte VII del documento maestro. Los tratamientos visuales del atlas son bocetos, no fronteras políticas verificadas.','Institutions, technologies and social conditions change the campaign. The boundaries of these six eras follow Part VII of the master document. The atlas treatments are sketches, not verified political borders.')}</p></div></section>}

{route === 'juego/mundo' && <section class="section"><figure class="wide-map"><img src="/images/atlas.svg" width="1100" height="800" alt={t(lang,'Mapa conceptual del Mediterráneo oriental','Concept map of the Eastern Mediterranean')}/><figcaption>{t(lang,'Geografía simplificada de referencia. Sin fronteras políticas verificadas.','Simplified reference geography. No verified political borders.')}</figcaption></figure><div class="section-heading"><h2>{t(lang,'18 puntos de partida propuestos.','18 proposed starting points.')}</h2><p>{t(lang,'Inventario del Anexo I. Las fichas históricas completas se publicarán en W3 tras contrastar sus datos y fuentes.','Inventory from Appendix I. Full historical profiles will be published in W3 after their data and sources have been checked.')}</p></div><div class="entity-grid">{entities.map((e,n)=><article><span>{String(n+1).padStart(2,'0')}</span><h3>{e[i]}</h3><small>{t(lang,'Ficha prevista · revisión pendiente','Profile planned · review pending')}</small></article>)}</div></section>}

{route === 'juego/situaciones' && <section class="section narrow prose"><span class="eyebrow">{t(lang,'EJEMPLO DE DISEÑO · §07','DESIGN EXAMPLE · §07')}</span><h2>{t(lang,'Constantinopla no cae por una fecha.','Constantinople does not fall because of a date.')}</h2><p>{t(lang,'La propuesta de 101 History trata los acontecimientos como situaciones: causas que acumulan presión, actores que responden y desenlaces que dependen del estado del mundo.','The proposal for 101 History treats events as situations: causes that build pressure, actors that respond and outcomes that depend on the state of the world.')}</p><div class="editorial-note"><h3>{t(lang,'Causas que pueden cambiar','Causes that can change')}</h3><p>{t(lang,'Defensas, recursos fiscales, abastecimiento y apoyos externos forman parte de la explicación que el diseño quiere hacer visible. Si el jugador cambia esas condiciones, el desenlace también debe poder cambiar.','Defenses, fiscal resources, supply and outside support are part of the explanation the design aims to make visible. If a player changes those conditions, the outcome must also be able to change.')}</p></div><h3>{t(lang,'Variantes y divergencia','Variants and divergence')}</h3><p>{t(lang,'La caída, la resistencia o una transformación política no se programan como una única escena inevitable. El catálogo completo y sus parámetros todavía requieren validación.','Fall, resistance or political transformation are not programmed as a single inevitable scene. The full catalog and its parameters still require validation.')}</p><p class="notice">{t(lang,'Esta página explica una propuesta mecánica. No presenta una reconstrucción histórica verificada. Las fichas documentadas se reservan para W3.','This page explains a mechanical proposal. It does not present a verified historical reconstruction. Documented profiles are reserved for W3.')}</p></section>}

{route === 'faq' && <section class="section narrow faq-list">{faq.map(f=><details><summary>{f[i]}<span aria-hidden="true">+</span></summary><p>{f[2+i]}</p></details>)}</section>}

{route === 'prensa' && <section class="section"><div class="press-grid"><div class="prose"><h2>{t(lang,'Project Epoch','Project Epoch')} <small>{t(lang,'(nombre provisional)','(working title)')}</small></h2><p>{t(lang,'Un proyecto de gran estrategia histórica de 101 Agents Games. La visión es guiar a un pueblo desde 1300 hasta más allá de 2060 en una partida continua, cambiando las causas de la historia y comprendiendo sus consecuencias. Actualmente en preparación; no hay una demo pública ni fecha comercial confirmada.','A historical grand strategy project from 101 Agents Games. The vision is to guide a people from 1300 to beyond 2060 in one continuous campaign, changing the causes of history and understanding their consequences. Currently in preparation, with no public demo or confirmed commercial release date.')}</p><h3>{t(lang,'Material editorial provisional','Provisional editorial materials')}</h3><p>{t(lang,'El paquete de revisión contiene descripciones, ficha técnica y una marca tipográfica provisional. Las capturas, el tráiler, los logotipos finales y las fotografías se añadirán cuando existan y se aprueben sus derechos.','The review package contains descriptions, a fact sheet and a provisional typographic mark. Screenshots, a trailer, final logos and photographs will be added when they exist and their rights are approved.')}</p><a class="button" href="/downloads/101-agents-games-press-draft.zip" download>{t(lang,'Descargar borrador de prensa','Download press draft')} <span aria-hidden="true">↓</span></a><p class="caption">ZIP · ES / EN · {t(lang,'Solo para revisión, no es el kit final','For review only, not the final kit')}</p></div><dl class="facts-table">{(lang==='es'?[['Estudio','101 Agents Games'],['Juego','Project Epoch (nombre provisional)'],['Motor','101 Engine'],['Género','Gran estrategia histórica'],['Estado','Preparación · sin demo pública'],['Plataformas','Pendientes de confirmación'],['Fecha y precio','No anunciados'],['Idiomas de la vertical','Español e inglés · objetivo'],['Contacto de prensa','Pendiente de designar']]:[['Studio','101 Agents Games'],['Game','Project Epoch (working title)'],['Engine','101 Engine'],['Genre','Historical grand strategy'],['Status','Preparation · no public demo'],['Platforms','Awaiting confirmation'],['Date and price','Not announced'],['Vertical slice languages','Spanish and English · target'],['Press contact','To be designated']]).map(([key,value])=><div><dt>{key}</dt><dd>{value}</dd></div>)}</dl></div><div class="editorial-note"><h3>{t(lang,'Política para creadores: pendiente','Creator policy: pending')}</h3><p>{t(lang,'El plan contempla permitir la monetización de vídeos del juego. El texto definitivo y su alcance requieren aprobación del titular antes de ofrecer ese permiso públicamente.','The plan envisages allowing monetized videos of the game. Final wording and scope require the rights holder’s approval before that permission is offered publicly.')}</p></div></section>}

{route === 'modding' && <section class="section narrow prose"><StatusBadge label={t(lang,'Objetivo para 1.0','Target for 1.0')}/><h2>{t(lang,'Primero, formatos estables. Después, otros mundos.','Stable formats first. Other worlds next.')}</h2><p>{t(lang,'La documentación pública cubrirá formatos de datos, lenguaje de condiciones, validación y versiones compatibles. Las guías llegarán cuando exista un contrato estable que podamos mantener.','Public documentation will cover data formats, the condition language, validation and compatible versions. Guides will arrive when there is a stable contract we can maintain.')}</p><ul><li>{t(lang,'Escenarios, entidades, culturas y situaciones.','Scenarios, entities, cultures and situations.')}</li><li>{t(lang,'Bienes, edificios, tecnologías y reglas de contenido.','Goods, buildings, technologies and content rules.')}</li><li>{t(lang,'Guías de validación y migración entre versiones.','Validation and version migration guides.')}</li></ul><p>{t(lang,'No hay una API pública de modding ni compatibilidad anunciada todavía. Forge público figura como propuesta posterior al lanzamiento.','There is no public modding API or announced compatibility yet. Public Forge is a post-launch proposal.')}</p><a class="text-link" href={path(lang,'motor')}>{t(lang,'Conocer 101 Engine','Explore 101 Engine')} ↗</a></section>}

{route.startsWith('legal') && <section class="section narrow prose"><div class="notice"><p>{t(lang,'Información de un prototipo privado. Las páginas legales finales requieren datos del titular, elección de proveedores y revisión humana antes del lanzamiento público.','Information for a private prototype. Final legal pages require owner details, selected providers and human review before public launch.')}</p></div>
 {route==='legal'&&<><div class="link-grid">{['legal/aviso','legal/privacidad','legal/terminos','legal/ia'].map(r=><a href={path(lang,r)}>{routeNames[r][i]} ↗</a>)}</div><h2>{t(lang,'La transparencia empieza aquí.','Transparency starts here.')}</h2><p>{t(lang,'Este sitio es una versión de revisión W0. El lanzamiento público W1 depende de verificar dominio y marca, aprobar los textos, configurar el boletín y completar las pruebas previstas.','This website is a W0 review version. Public W1 launch depends on domain and trademark checks, content approval, newsletter setup and the planned tests.')}</p></>}
 {route==='legal/aviso'&&<><h2>{t(lang,'Identificación pendiente','Identification pending')}</h2><p>{t(lang,'101 Agents Games es el nombre de estudio utilizado en el documento de diseño. El nombre legal del titular, domicilio de contacto, jurisdicción y correo oficial todavía no se han facilitado.','101 Agents Games is the studio name used in the design document. The owner’s legal name, contact address, jurisdiction and official email have not yet been supplied.')}</p><p>{t(lang,'No se inventan datos de contacto ni registros de marca. Estos campos deben completarse antes de abrir el sitio al público.','Contact details and trademark registrations are not invented. These fields must be completed before opening the site to the public.')}</p></>}
 {route==='legal/privacidad'&&<><h2>{t(lang,'Qué hace este prototipo','What this prototype does')}</h2><ul><li>{t(lang,'El código del sitio no instala cookies de seguimiento ni servicios de analítica.','The website code does not install tracking cookies or analytics services.')}</li><li>{t(lang,'El selector de tema guarda solo la preferencia clara u oscura en el almacenamiento local del navegador.','The theme selector stores only your light or dark preference in browser local storage.')}</li><li>{t(lang,'La suscripción está cerrada: no recogemos correos mediante este sitio.','Subscriptions are closed: we do not collect emails through this website.')}</li><li>{t(lang,'Las tipografías son del sistema y los recursos visuales se sirven desde el propio sitio.','Fonts are system fonts and visual assets are served by the website itself.')}</li></ul><h3>{t(lang,'Alojamiento y acceso privado','Hosting and private access')}</h3><p>{t(lang,'El acceso privado y la infraestructura son gestionados por Sites. Los registros técnicos o la autenticación del alojamiento están fuera del código de esta página; deben revisarse al cerrar la política definitiva.','Private access and infrastructure are managed by Sites. Hosting technical logs or authentication are outside this page’s code; they must be reviewed when finalizing the policy.')}</p><h3>{t(lang,'Antes de activar el boletín','Before enabling the newsletter')}</h3><p>{t(lang,'Se identificarán responsable, proveedor, finalidades, base de tratamiento, conservación y vías para baja o borrado. La doble confirmación debe comprobarse con el proveedor elegido.','The controller, provider, purposes, processing basis, retention and unsubscribe or deletion channels will be identified. Double opt-in must be tested with the selected provider.')}</p></>}
 {route==='legal/terminos'&&<><h2>{t(lang,'Materiales en revisión','Materials under review')}</h2><p>{t(lang,'Los textos, traducciones, atlas y marca tipográfica de este prototipo son materiales provisionales. No constituyen una oferta de venta ni prometen disponibilidad de funciones.','Texts, translations, atlas and typographic mark in this prototype are provisional materials. They do not constitute a sales offer or promise feature availability.')}</p><p>{t(lang,'El kit de prensa definitivo, las licencias de reutilización y la política para monetizar vídeos requieren aprobación del titular. No se concede aquí un permiso que aún no se ha confirmado.','The final press kit, reuse licenses and monetized-video policy require rights holder approval. No unconfirmed permission is granted here.')}</p></>}
 {route==='legal/ia'&&<><h2>{t(lang,'Declaración de uso de IA','AI-use statement')}</h2><p>{t(lang,'La programación, la maquetación, los textos de borrador y la traducción de este prototipo se han preparado con asistencia de IA. La aprobación editorial e histórica corresponde a una persona.','Programming, layout, draft text and translation for this prototype were prepared with AI assistance. Editorial and historical approval belongs to a human.')}</p><h3>{t(lang,'Recursos visuales y tipografías','Visual assets and fonts')}</h3><ul><li>{t(lang,'Atlas: ilustración SVG original elaborada mediante código con asistencia de IA. Geografía esquemática; no contiene cartografía histórica verificada ni capturas del juego.','Atlas: original SVG illustration produced through code with AI assistance. Schematic geography; contains no verified historical cartography or game screenshots.')}</li><li>{t(lang,'Marca y favicon: composiciones vectoriales provisionales para este prototipo.','Wordmark and favicon: provisional vector compositions for this prototype.')}</li><li>{t(lang,'Tipografías: Georgia y fuentes sans del sistema; no se distribuyen archivos de fuentes.','Typography: Georgia and system sans-serif fonts; no font files are distributed.')}</li><li>{t(lang,'Astro, integración MDX, integración sitemap, YAML y Zod: bibliotecas con licencia MIT. Versiones exactas en el archivo de dependencias bloqueadas.','Astro, MDX integration, sitemap integration, YAML and Zod: MIT-licensed libraries. Exact versions are recorded in the dependency lockfile.')}</li></ul><p>{t(lang,'No se utilizan fotografías de terceros, retratos generados ni imágenes de una build del juego. La política definitiva de arte y audio del juego sigue abierta.','No third-party photographs, generated portraits or game-build screenshots are used. The game’s final art and audio policy remains undecided.')}</p></>}
 </section>}

<script>
 const lang = document.documentElement.lang;
 const count = document.querySelector('[data-result-count]');
 const empty = document.querySelector<HTMLElement>('[data-empty]');
 const announce = (n:number) => {if(count)count.textContent=lang==='es'?`${n} ${n===1?'entrada':'entradas'}`:`${n} ${n===1?'entry':'entries'}`;if(empty)empty.hidden=n!==0};
 const normalize = (v:string)=>v.toLocaleLowerCase(lang).normalize('NFD').replace(/[\u0300-\u036f]/g,'');
 const search=document.querySelector<HTMLInputElement>('#diary-search');
 const type=document.querySelector<HTMLSelectElement>('#diary-type');
 function filterDiaries(){let n=0;document.querySelectorAll<HTMLElement>('[data-diary]').forEach(el=>{const show=(!type||type.value==='all'||type.value===el.dataset.type)&&normalize(el.dataset.search||'').includes(normalize(search?.value||''));el.hidden=!show;if(show)n++});announce(n)}
 if(search){search.addEventListener('input',filterDiaries);type?.addEventListener('change',filterDiaries);filterDiaries()}
 const channel=document.querySelector<HTMLSelectElement>('#change-channel');
 const kind=document.querySelector<HTMLSelectElement>('#change-kind');
 function filterChanges(){let n=0;document.querySelectorAll<HTMLElement>('[data-change]').forEach(el=>{const show=(!channel||channel.value==='all'||channel.value===el.dataset.channel)&&(!kind||kind.value==='all'||(el.dataset.kinds||'').split(' ').includes(kind.value));el.hidden=!show;if(show)n++;el.querySelectorAll<HTMLElement>('[data-change-group]').forEach(group=>group.hidden=!!kind&&kind.value!=='all'&&group.dataset.changeGroup!==kind.value)});announce(n)}
 if(channel){channel.addEventListener('change',filterChanges);kind?.addEventListener('change',filterChanges);filterChanges()}
</script>
