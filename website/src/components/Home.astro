---
import { t, path } from '../data/site';
import StatusBadge from './StatusBadge.astro';
import ProjectStatus from './ProjectStatus.astro';
import CausalChain from './CausalChain.astro';
import EraJourney from './EraJourney.astro';
const { lang = 'es' } = Astro.props;
---
<section class="hero"><div class="hero-art"><img src="/images/atlas.svg" alt={t(lang,'Atlas conceptual del Mediterráneo oriental, con rutas entre Venecia, Constantinopla y Alejandría. No es una captura del juego.','Conceptual atlas of the Eastern Mediterranean with routes between Venice, Constantinople and Alexandria. Not a game screenshot.')} width="1100" height="800" fetchpriority="high"/><div class="map-caption"><span aria-hidden="true">✳</span> {t(lang,'MEDITERRÁNEO ORIENTAL · 1300','EASTERN MEDITERRANEAN · 1300')}<small>{t(lang,'Ilustración conceptual · geografía simplificada','Concept illustration · simplified geography')}</small></div></div><div class="hero-inner"><div class="hero-copy"><div class="hero-kicker"><span class="tiny-rule"></span><span class="eyebrow">{t(lang,'UN JUEGO DE 101 AGENTS GAMES','A GAME BY 101 AGENTS GAMES')}</span></div><p class="project-name">Project Epoch <span>{t(lang,'nombre provisional','working title')}</span></p><h1>{t(lang,'La historia no','History doesn’t')}<br/>{t(lang,'está escrita.','write itself.')}<br/><em>{t(lang,'Sus causas, sí.','Its causes do.')}</em></h1><p class="hero-description">{t(lang,'Guía a tu pueblo desde 1300 hasta más allá de 2060. Cambia las causas. Descubre las consecuencias. Y entiende por qué el mundo terminó siendo como es.','Guide your people from 1300 to beyond 2060. Change the causes. Discover the consequences. And understand why the world became what it is.')}</p><div class="hero-buttons"><a class="button" href={path(lang,'juego')}>{t(lang,'Descubre el juego','Discover the game')} <span aria-hidden="true">↗</span></a><a class="quiet-link" href="#epocas">{t(lang,'Recorre las épocas','Travel through the eras')} <span aria-hidden="true">↓</span></a></div><div class="hero-status"><StatusBadge label={t(lang,'En preparación','In preparation')} tone="green"/><span>{t(lang,'Una visión en desarrollo. Aún no jugable.','A vision in development. Not yet playable.')}</span></div></div></div></section>
<div class="facts-strip"><div><span>1300 — 2060+</span><small>{t(lang,'Una sola partida continua · objetivo','One continuous campaign · target')}</small></div><div><span>{t(lang,'Cada decisión deja huella','Every decision leaves a trace')}</span><small>{t(lang,'Gran estrategia histórica con causalidad','Historical grand strategy with causality')}</small></div><div><span>101 Engine</span><small>{t(lang,'Un mundo simulado. Una historia explicable.','A simulated world. An explainable history.')}</small></div></div>
<section class="section intro-section"><div><span class="eyebrow">01 / {t(lang,'LA IDEA','THE IDEA')}</span><h2>{t(lang,'No basta con conquistar.','Conquest is only the beginning.')}<br/><em>{t(lang,'Hay que comprender.','Understanding comes next.')}</em></h2></div><div class="intro-copy"><p class="large-copy">{t(lang,'Cada guerra cuesta grano, hombres y deuda. Cada reforma cambia quién manda. Cada invento necesita sus precursores.','Every war costs grain, people and debt. Every reform changes who holds power. Every invention needs its precursors.')}</p><p>{t(lang,'La historia real sigue su curso mientras sus causas existan. Cuando las cambias, aparece otra historia. Nuestra propuesta es que siempre puedas preguntar «¿por qué?».','Real history follows its course as long as its causes remain. Change them, and another history emerges. Our proposal is that you can always ask “why?”.')}</p><a class="text-link" href={path(lang,'juego')}>{t(lang,'Conoce los cinco pilares del juego','Explore the five defining ideas')} <span aria-hidden="true">↗</span></a></div></section>
<section class="causal-section"><div class="section"><div class="section-heading"><div><span class="eyebrow">02 / {t(lang,'UNA DECISIÓN, MUCHAS CONSECUENCIAS','ONE DECISION, MANY CONSEQUENCES')}</span><h2>{t(lang,'Bizancio, primavera de 1303.','Byzantium, spring 1303.')}</h2></div><p>{t(lang,'El tesoro está vacío. La frontera no espera. Así se imagina una cadena causal en Project Epoch.','The treasury is empty. The border cannot wait. This is how a causal chain is envisioned in Project Epoch.')}</p></div><CausalChain lang={lang}/></div></section>
<section class="section" id="epocas"><div class="section-heading"><div><span class="eyebrow">03 / {t(lang,'EL MISMO MUNDO. OTRAS REGLAS.','THE SAME WORLD. CHANGING RULES.')}</span><h2>{t(lang,'Siete siglos.','Seven centuries.')}<br/><em>{t(lang,'Ningún salto artificial.','No artificial resets.')}</em></h2></div><p>{t(lang,'Del pergamino a la cartografía digital. El mundo cambia cuando sus instituciones, tecnologías y sociedades están listas. Estas escenas ilustran la visión, no funciones terminadas.','From parchment to digital cartography. The world changes when its institutions, technologies and societies are ready. These scenes illustrate the vision, not completed features.')}</p></div><EraJourney lang={lang}/><div class="section-end"><span>{t(lang,'Seis épocas propuestas · ilustraciones conceptuales','Six proposed eras · conceptual illustrations')}</span><a class="text-link" href={path(lang,'juego/epocas')}>{t(lang,'Explorar las épocas','Explore the eras')} <span aria-hidden="true">↗</span></a></div></section>
<div class="section status-wrapper"><ProjectStatus lang={lang}/></div>
<section class="section diary-feature"><div><span class="eyebrow">04 / {t(lang,'DESDE LA MESA DE TRABAJO','FROM THE WORKTABLE')}</span><h2>{t(lang,'El desarrollo,','Development,')}<br/><em>{t(lang,'a la vista.','in the open.')}</em></h2><p>{t(lang,'Decisiones, pruebas y preguntas abiertas. Los diarios regulares empezarán en la Fase 2. Mientras tanto, un primer borrador para conocer la visión.','Decisions, tests and open questions. Regular diaries will begin in Phase 2. In the meantime, a first draft introduces the vision.')}</p><a class="text-link" href={path(lang,'diarios')}>{t(lang,'Todos los diarios','All dev diaries')} <span aria-hidden="true">↗</span></a></div><a class="diary-preview" href={path(lang,'diarios/una-partida')}><div class="diary-illustration"><span>1300</span><i aria-hidden="true">→</i><span>2060+</span></div><div class="diary-preview-copy"><span class="eyebrow">{t(lang,'DISEÑO · BORRADOR EDITORIAL','DESIGN · EDITORIAL DRAFT')}</span><h3>{t(lang,'Una partida. Siete siglos de consecuencias.','One campaign. Seven centuries of consequences.')}</h3><div class="diary-meta"><span>{t(lang,'24 oct 2026 · 3 min de lectura','24 Oct 2026 · 3 min read')}</span><span aria-hidden="true">↗</span></div></div></a></section>
<section class="follow-section"><span class="eyebrow">{t(lang,'EL PRÓXIMO CAPÍTULO','THE NEXT CHAPTER')}</span><h2>{t(lang,'La historia apenas comienza.','The story is just beginning.')}</h2><p>{t(lang,'Acompaña el desarrollo. Sin ruido, sin promesas imposibles.','Follow development. No noise, no impossible promises.')}</p><a class="button light" href={path(lang,'comunidad')+'#boletin'}>{t(lang,'Sigue el proyecto','Follow the project')} <span aria-hidden="true">↗</span></a></section>
