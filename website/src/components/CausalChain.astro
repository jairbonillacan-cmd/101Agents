---
import { t } from '../data/site';
const { lang = 'es' } = Astro.props;
const steps = lang === 'es' ? [ ['01','El tesoro no alcanza','La flota necesita dinero. Las guarniciones llevan cinco meses sin cobrar.'], ['02','La frontera cede','Las aldeas huyen a la costa. Dos fortalezas de Bitinia se pierden.'], ['03','Tú decides','Devaluar, gravar a los monasterios o contratar a la Compañía Catalana.'], ['04','La deuda vuelve','En el ejemplo, el pago a los mercenarios se retrasa y estos se vuelven contra el imperio.'] ] : [ ['01','The treasury falls short','The fleet needs money. Garrisons have gone unpaid for five months.'], ['02','The border gives way','Villagers flee to the coast. Two fortresses in Bithynia are lost.'], ['03','You decide','Debase the currency, tax monasteries or hire the Catalan Company.'], ['04','Debt comes back','In this example, mercenary pay is delayed and they turn against the empire.'] ];
---
<div class="causal-chain">{steps.map(([n,title,body]) => <div class="causal-step"><span class="step-number">{n}</span><h3>{title}</h3><p>{body}</p></div>)}</div>
<details class="ledger"><summary>{t(lang,'Abrir el registro causal del ejemplo','Open the example’s causal ledger')} <span aria-hidden="true">+</span></summary><div><p class="eyebrow">{t(lang,'Escena de diseño · no es una partida real','Design scene · not an actual playthrough')}</p><ol><li>{t(lang,'Restricción: tesoro insuficiente para obligaciones militares.','Constraint: insufficient treasury for military obligations.')}</li><li>{t(lang,'Efecto inmediato: impagos y defensa debilitada.','Immediate effect: unpaid wages and weakened defenses.')}</li><li>{t(lang,'Decisión ilustrada: contratar a la Compañía Catalana con pago adelantado.','Illustrated decision: hire the Catalan Company with an advance payment.')}</li><li>{t(lang,'Dos años después, en el relato: victorias en Anatolia, nuevo retraso del pago y ruptura del contrato.','Two years later in the story: victories in Anatolia, another payment delay and a broken contract.')}</li></ol><p>{t(lang,'No hay una opción sin coste. La propuesta es poder rastrear cada consecuencia, incluso años después. Fuente: documento maestro v0.7, §01.','There is no cost-free option. The proposal is to trace each consequence, even years later. Source: master document v0.7, §01.')}</p></div></details>
