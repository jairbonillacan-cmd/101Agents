---
import '../styles/global.css';
import { t, path, routeNames } from '../data/site';
const { lang = 'es', route = '', title = '101 Agents Games', description = t(lang,'Una partida, siete siglos de consecuencias. Descubre la visión de Project Epoch y el desarrollo de 101 Agents Games.','One campaign, seven centuries of consequences. Explore the vision for Project Epoch and the development of 101 Agents Games.') } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = ['juego','diarios','hoja-de-ruta','cambios','comunidad'];
---
<!doctype html>
<html lang={lang}>
 <head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="color-scheme" content="light dark"/><title>{title === '101 Agents Games' ? title + ' — ' + t(lang,'La historia tiene consecuencias','History has consequences') : title + ' · 101 Agents Games'}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="alternate" hreflang="es" href={new URL(path('es',route),Astro.site)}/><link rel="alternate" hreflang="en" href={new URL(path('en',route),Astro.site)}/><link rel="alternate" hreflang="x-default" href={new URL(path('es',route),Astro.site)}/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'}/><meta name="theme-color" content="#f3f0e7"/><link rel="alternate" type="application/rss+xml" title={t(lang,'Diarios','Dev diaries')} href={path(lang) + 'diarios/rss.xml'}/><link rel="alternate" type="application/rss+xml" title={t(lang,'Cambios','Changelog')} href={path(lang) + 'cambios/rss.xml'}/>
 <script is:inline>try{const s=localStorage.getItem('101-theme');if(s==='dark'||s==='light')document.documentElement.dataset.theme=s}catch{}</script>
 <noscript><style is:inline>.theme-button,.menu-button{display:none!important}@media(max-width:980px){#mobile-nav[hidden]{display:block!important}}</style></noscript>
 </head>
 <body>
 <a class="skip-link" href="#main">{t(lang,'Saltar al contenido','Skip to content')}</a>
 <header class="site-header"><div class="header-inner"><a class="brand" href={path(lang)} aria-label="101 Agents Games"><span class="brand-number">101<span class="brand-star" aria-hidden="true">✳</span></span><span class="brand-name">AGENTS<br/>GAMES</span></a><nav class="desktop-nav" aria-label={t(lang,'Navegación principal','Main navigation')}>{nav.map(item => <a href={path(lang,item)} aria-current={route === item || (item === 'juego' && route.startsWith('juego/')) ? 'page' : undefined}>{routeNames[item][lang === 'es' ? 0 : 1]}</a>)}</nav><div class="header-actions"><a class="language" href={path(lang === 'es' ? 'en' : 'es',route)} lang={lang === 'es' ? 'en' : 'es'} aria-label={t(lang,'Read in English','Leer en español')}>{lang === 'es' ? 'EN' : 'ES'}</a><button class="theme-button" aria-label={t(lang,'Cambiar tema claro u oscuro','Toggle light or dark theme')} title={t(lang,'Cambiar tema','Toggle theme')}><span aria-hidden="true">◐</span></button><a class="button small header-cta" href={path(lang,'comunidad')+'#boletin'}>{t(lang,'Suscríbete','Subscribe')} <span aria-hidden="true">↗</span></a><button class="menu-button" aria-expanded="false" aria-controls="mobile-nav">{t(lang,'Menú','Menu')} <span aria-hidden="true">☰</span></button></div></div><nav id="mobile-nav" class="mobile-nav" hidden aria-label={t(lang,'Navegación móvil','Mobile navigation')}>{nav.map(item => <a href={path(lang,item)}>{routeNames[item][lang === 'es' ? 0 : 1]}</a>)}<a href={path(lang,'comunidad')+'#boletin'}>{t(lang,'Suscríbete','Subscribe')}</a></nav></header>
 <main id="main" tabindex="-1"><slot/></main>
 <footer class="site-footer"><div class="footer-top"><div><a class="brand" href={path(lang)}><span class="brand-number">101<span class="brand-star" aria-hidden="true">✳</span></span><span class="brand-name">AGENTS<br/>GAMES</span></a><p>{t(lang,'La historia tiene inercia.\nEl futuro tiene posibilidades.','History has inertia.\nThe future has possibilities.')}</p></div><div class="footer-column"><span class="eyebrow">{t(lang,'Explora','Explore')}</span>{['estudio','motor','prensa','faq'].map(r=><a href={path(lang,r)}>{routeNames[r][lang === 'es' ? 0 : 1]}</a>)}</div><div class="footer-column"><span class="eyebrow">{t(lang,'Sigue el proyecto','Follow the project')}</span><a href={path(lang,'comunidad')}>{t(lang,'Comunidad y boletín','Community and newsletter')}</a><a href={path(lang)+'diarios/rss.xml'}>RSS · {t(lang,'Diarios','Diaries')}</a><a href={path(lang)+'cambios/rss.xml'}>RSS · {t(lang,'Cambios','Changelog')}</a><a href={path(lang,'modding')}>Modding</a></div><div class="footer-column"><span class="eyebrow">{t(lang,'Transparencia','Transparency')}</span><a href={path(lang,'legal')}>{t(lang,'Legal y privacidad','Legal and privacy')}</a><a href={path(lang,'legal/ia')}>{t(lang,'Uso de IA y licencias','AI use and licenses')}</a><a href={path(lang==='es'?'en':'es',route)}>{lang==='es'?'English version':'Versión en español'}</a></div></div><div class="footer-bottom"><span>© 2026 · 101 Agents Games</span><span>{t(lang,'Project Epoch es un nombre provisional.','Project Epoch is a working title.')}</span><span>{t(lang,'Prototipo privado · revisión editorial pendiente','Private prototype · editorial review pending')}</span></div></footer>
 <script>
 const menu = document.querySelector<HTMLButtonElement>('.menu-button');
 const mobile = document.querySelector<HTMLElement>('#mobile-nav');
 menu?.addEventListener('click',()=>{const open=menu.getAttribute('aria-expanded')!=='true';menu.setAttribute('aria-expanded',String(open));if(mobile)mobile.hidden=!open});
 document.addEventListener('keydown', e=>{if(e.key==='Escape'&&menu?.getAttribute('aria-expanded')==='true'){menu.setAttribute('aria-expanded','false');if(mobile)mobile.hidden=true;menu.focus()}});
 document.querySelector('.theme-button')?.addEventListener('click',()=>{const root=document.documentElement;const dark=root.dataset.theme?root.dataset.theme==='dark':matchMedia('(prefers-color-scheme: dark)').matches;root.dataset.theme=dark?'light':'dark';try{localStorage.setItem('101-theme',root.dataset.theme)}catch{}});
 </script>
 </body>
</html>
